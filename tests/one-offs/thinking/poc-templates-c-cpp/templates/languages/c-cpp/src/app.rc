// Windows version resource. Every number and string comes from version.h,
// so a bump never edits this file (and its encoding never matters).
#include "__RK_SNAKE__/version.h"

1 VERSIONINFO
 FILEVERSION __RK_MACRO___VERSION_MAJOR,__RK_MACRO___VERSION_MINOR,__RK_MACRO___VERSION_PATCH,0
 PRODUCTVERSION __RK_MACRO___VERSION_MAJOR,__RK_MACRO___VERSION_MINOR,__RK_MACRO___VERSION_PATCH,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "__RK_DESCRIPTION__"
            VALUE "FileVersion", __RK_MACRO___VERSION_STRING
            VALUE "ProductName", "__RK_PROJECT__"
            VALUE "ProductVersion", __RK_MACRO___VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
